<?xml version="1.0" encoding="UTF-8"?>

<!-- Registration page -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="splash-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.javafxdb_sql_shellcode.RegistrationController">
   <VBox styleClass="card" maxWidth="380" maxHeight="-Infinity" spacing="8">
      <Label text="Create account" styleClass="title"/>
      <Label text="All fields are required." styleClass="muted"/>

      <HBox spacing="10">
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="First Name" styleClass="field-label"/>
            <TextField fx:id="firstNameField" promptText="First"/>
         </VBox>
         <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Last Name" styleClass="field-label"/>
            <TextField fx:id="lastNameField" promptText="Last"/>
         </VBox>
      </HBox>
      <Label text="Email" styleClass="field-label"/>
      <TextField fx:id="emailField" promptText="name@farmingdale.edu"/>
      <Label text="Password (8+ characters, a letter and a number)" styleClass="field-label"/>
      <PasswordField fx:id="passwordField" promptText="Password"/>
      <Label text="Confirm Password" styleClass="field-label"/>
      <PasswordField fx:id="confirmField" promptText="Confirm password"/>
      <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

      <Button text="Register" onAction="#onRegister" defaultButton="true" styleClass="primary-btn" maxWidth="Infinity"/>
      <HBox alignment="CENTER">
         <Hyperlink text="Back to sign in" onAction="#goToLogin"/>
      </HBox>
   </VBox>
</StackPane>
