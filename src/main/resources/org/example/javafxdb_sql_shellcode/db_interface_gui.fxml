<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.javafxdb_sql_shellcode.DB_GUI_Controller">

   <fx:define>
      <ToggleGroup fx:id="themeGroup"/>
   </fx:define>

   <!-- ================= MENU BAR ================= -->
   <top>
      <MenuBar>
         <Menu text="_File">
            <MenuItem text="Upload Profile Picture..." onAction="#showImage" accelerator="Shortcut+F"/>
            <SeparatorMenuItem/>
            <MenuItem text="Log Out" onAction="#logout" accelerator="Shortcut+L"/>
            <MenuItem text="Exit" onAction="#closeApplication" accelerator="Shortcut+Q"/>
         </Menu>
         <Menu text="_Edit">
            <MenuItem text="New / Clear Form" onAction="#clearForm" accelerator="Shortcut+N"/>
            <MenuItem text="Search by Name" onAction="#focusSearch" accelerator="Shortcut+K"/>
         </Menu>
         <Menu text="_Database">
            <MenuItem fx:id="addItem" text="Add Record" onAction="#addNewRecord" accelerator="Shortcut+S"/>
            <MenuItem fx:id="editItem" text="Update Selected" onAction="#editRecord" accelerator="Shortcut+E"/>
            <MenuItem fx:id="deleteItem" text="Delete Selected" onAction="#deleteRecord" accelerator="Shortcut+D"/>
            <SeparatorMenuItem/>
            <MenuItem text="Refresh Table" onAction="#loadData" accelerator="F5"/>
         </Menu>
         <Menu text="_View">
            <RadioMenuItem fx:id="lightItem" text="Light Theme" toggleGroup="$themeGroup" onAction="#setLightTheme"/>
            <RadioMenuItem fx:id="darkItem" text="Dark Theme" toggleGroup="$themeGroup" onAction="#setDarkTheme"/>
            <SeparatorMenuItem/>
            <MenuItem text="Toggle Theme" onAction="#toggleTheme" accelerator="Shortcut+T"/>
         </Menu>
         <Menu text="_Help">
            <MenuItem text="Keyboard Shortcuts" onAction="#showShortcuts" accelerator="F1"/>
            <MenuItem text="Challenges &amp; Solutions" onAction="#showChallenges" accelerator="Shortcut+H"/>
            <SeparatorMenuItem/>
            <MenuItem text="About" onAction="#showAbout"/>
         </Menu>
      </MenuBar>
   </top>

   <!-- ================= LEFT: picture + form ================= -->
   <left>
      <VBox styleClass="sidebar" prefWidth="290" spacing="6">
         <!-- Profile picture: click it to upload -->
         <HBox alignment="CENTER">
            <ImageView fx:id="img_view" fitWidth="120" fitHeight="120" pickOnBounds="true"
                       onMouseClicked="#showImage" styleClass="profile_pic">
               <cursor><javafx.scene.Cursor fx:constant="HAND"/></cursor>
            </ImageView>
         </HBox>
         <Label text="Click the photo to upload (Ctrl+F)" styleClass="muted" maxWidth="Infinity"
                alignment="CENTER"/>

         <Label text="First Name" styleClass="field-label"><VBox.margin><Insets top="8"/></VBox.margin></Label>
         <TextField fx:id="first_name" promptText="e.g. John"/>
         <Label text="Last Name" styleClass="field-label"/>
         <TextField fx:id="last_name" promptText="e.g. Pork"/>
         <Label text="Department" styleClass="field-label"/>
         <TextField fx:id="department" promptText="e.g. CPIS"/>
         <Label text="Major" styleClass="field-label"/>
         <TextField fx:id="major" promptText="e.g. Computer Science"/>
         <Label text="Email" styleClass="field-label"/>
         <TextField fx:id="email" promptText="e.g. name@farmingdale.edu"/>
         <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

         <!-- Buttons (same actions as the Database menu) -->
         <HBox spacing="8">
            <Button fx:id="addBtn" text="Add" onAction="#addNewRecord" styleClass="primary-btn" maxWidth="Infinity" HBox.hgrow="ALWAYS">
               <tooltip><Tooltip text="Add new record (Ctrl+S)"/></tooltip>
            </Button>
            <Button fx:id="editBtn" text="Update" onAction="#editRecord" styleClass="primary-btn" maxWidth="Infinity" HBox.hgrow="ALWAYS">
               <tooltip><Tooltip text="Save changes to selected record (Ctrl+E)"/></tooltip>
            </Button>
         </HBox>
         <HBox spacing="8">
            <Button fx:id="deleteBtn" text="Delete" onAction="#deleteRecord" styleClass="danger-btn" maxWidth="Infinity" HBox.hgrow="ALWAYS">
               <tooltip><Tooltip text="Delete selected record (Ctrl+D)"/></tooltip>
            </Button>
            <Button text="Clear" onAction="#clearForm" styleClass="secondary-btn" maxWidth="Infinity" HBox.hgrow="ALWAYS">
               <tooltip><Tooltip text="Clear the form (Ctrl+N)"/></tooltip>
            </Button>
         </HBox>
      </VBox>
   </left>

   <!-- ================= CENTER: search + table ================= -->
   <center>
      <VBox spacing="10">
         <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
         <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Students" styleClass="title"/>
            <javafx.scene.layout.Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Search by name (Ctrl+K)" prefWidth="240"/>
         </HBox>
         <TableView fx:id="tv" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <placeholder><Label text="No records yet. Fill in the form and click Add." styleClass="muted"/></placeholder>
            <columns>
               <TableColumn fx:id="tv_id" text="ID" prefWidth="45"/>
               <TableColumn fx:id="tv_fn" text="First Name" prefWidth="100"/>
               <TableColumn fx:id="tv_ln" text="Last Name" prefWidth="100"/>
               <TableColumn fx:id="tv_dept" text="Department" prefWidth="95"/>
               <TableColumn fx:id="tv_major" text="Major" prefWidth="120"/>
               <TableColumn fx:id="tv_email" text="Email" prefWidth="180"/>
            </columns>
         </TableView>
      </VBox>
   </center>

   <!-- ================= BOTTOM: status bar ================= -->
   <bottom>
      <HBox styleClass="status-bar">
         <Label fx:id="statusLabel" text="Ready"/>
      </HBox>
   </bottom>
</BorderPane>
